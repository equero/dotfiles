{
  "name": "@equerodev/dotfiles",
  "version": "0.4.2",
  "description": "Personal dotfiles + tooling, synced across machines via Git, browsable as a static Astro site.",
  "author": {
    "name": "Enrique Quero",
    "url": "https://equero.dev"
  },
  "keywords": [
    "dotfiles",
    "claude-code",
    "neovim",
    "astro"
  ],
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/equero/dotfiles.git"
  },
  "homepage": "https://github.com/equero/dotfiles#readme",
  "bugs": {
    "url": "https://github.com/equero/dotfiles/issues"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "host": "npm --prefix web run host",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "lint": "npm --prefix web run lint",
    "install:web": "npm --prefix web install"
  }
}
